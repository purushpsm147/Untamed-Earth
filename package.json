{
  "name": "untamed-earth",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @untamed/web",
    "build": "npm run typecheck && npm run build -w @untamed/web",
    "preview": "npm run preview -w @untamed/web",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --project=smoke --project=reliability --project=gameplay --project=documentary --project=audio",
    "documentary": "playwright test --project=documentary",
    "test:smoke": "playwright test --project=smoke",
    "bench": "tsx benchmarks/sim-bench.ts",
    "sim": "tsx benchmarks/sim-report.ts",
    "movement": "tsx benchmarks/movement-report.ts",
    "audio:render": "playwright test --project=audio-render --trace off"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
